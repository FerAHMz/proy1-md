            "# 5.3 Test Chi-cuadrado de uniformidad\n",
            "print(\"=\"*80)\n",
            "print(\"5.3 TEST ESTADÍSTICO DE ESTACIONALIDAD\")\n",
            "print(\"=\"*80)\n",
            "\n",
            "# Chi-cuadrado: ¿la distribución mensual es uniforme?\n",
            "from scipy.stats import chisquare\n",
            "observed = dist_mes_vio.values\n",
            "expected = np.full(12, dist_mes_vio.sum() / 12)\n",
            "\n",
            "chi_stat, p_value = chisquare(observed, expected)\n",
            "\n",
            "print(f\"\\n  Hipótesis Nula (H₀): Distribución mensual uniforme (p = 1/12 cada mes)\")\n",
            "print(f\"  Hipótesis Alternativa (H₁): Distribución NO uniforme\")\n",
            "print(f\"\\n  Estadístico χ²: {chi_stat:.2f}\")\n",
            "print(f\"  Grados de libertad: 11\")\n",
            "print(f\"  P-value: {p_value:.2e}\")\n",
            "\n",
            "if p_value < 0.05:\n",
