            "# Verificar si la predicción específica es correcta: ¿diciembre-enero son los meses con mayor incidencia?\n",
            "casos_dic = dist_mes_vio.get(12, 0)\n",
            "casos_ene = dist_mes_vio.get(1, 0)\n",
            "promedio_festivo = (casos_dic + casos_ene) / 2\n",
