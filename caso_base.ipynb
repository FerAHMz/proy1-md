            "ax.set_xlabel(f'PC1 ({pca_alt.explained_variance_ratio_[0]*100:.1f}% varianza)', fontsize=12)\n",
            "ax.set_ylabel(f'PC2 ({pca_alt.explained_variance_ratio_[1]*100:.1f}% varianza)', fontsize=12)\n",
