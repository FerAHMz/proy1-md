            "print(f\"  → Promedio festivo (dic-ene): {promedio_festivo:,.0f}\")\n",
            "print(f\"  → Promedio general mensual: {promedio:,.0f}\")\n",
            "print(f\"  → Diciembre: {casos_dic:,.0f} ({((casos_dic - promedio)/promedio)*100:+.1f}% vs promedio)\")\n",
            "print(f\"  → Enero: {casos_ene:,.0f} ({((casos_ene - promedio)/promedio)*100:+.1f}% vs promedio)\")\n",
            "\n",
            "if promedio_festivo > promedio:\n",
            "    resultado_h5 = \"ACEPTADA\"\n",
