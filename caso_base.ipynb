            "    print(f\"\\n  ✗ Dic-Ene están POR DEBAJO del promedio → Predicción INCORRECTA\")\n",
            "    print(f\"  → Los meses festivos tienen MENOR incidencia, no mayor\")\n",
            "\n",
            "# Resumen\n",
